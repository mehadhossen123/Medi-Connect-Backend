// payment er model 
model Payment{
    id String @id @default(uuid())

    status PaymentStatus @default(UNPAID)

    amount Decimal @db.Decimal(10,2)

    currency String @default("BDT")

    paymentGateway String @default("bkash")
    merchantInvoiceId String @unique   // appointment id 

    bkashPaymentId String? @unique

    bkashTxId String? 

    payerReference String    //user email or phone number
    appointmentId String @unique
    paidAt String?


    gateWayResponse Json?


    refundTrxId String?
    refundAmount Decimal @db.Decimal(10,2)
    refundReason String?
    refundAt String?


    appointment Appointment @relation(fields: [appointmentId],references: [id],onDelete: Cascade,onUpdate: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt






    @@map("payments")
}